# Office Axe cloud server settings. Copy to deploy/.env and fill in.
# deploy/.env is git-ignored: never commit real keys.

# The web address staff type into Office Axe, without https://
# Point this name's DNS "A" record at the server's IP address first.
OFFICE_AXE_DOMAIN=files.example.com

# 1 = every signed-in account gets the paid features without Stripe.
# Keep 1 until Stripe is set up, then remove it.
SFM_FREE_PLAN=1

# Shared-drive space per office, in MB (51200 = 50 GB). Keep it below the
# server's disk size.
SFM_OFFICE_QUOTA_MB=51200
SFM_STORAGE_QUOTA_MB=5120
SFM_MAX_UPLOAD_MB=200

# Stripe monthly plan (optional; see server/.env.example for details)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SFM_PLAN_LABEL=Monthly plan
