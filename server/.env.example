# PDF Axe account server settings.
#
# Copy this file to server/.env (it is git-ignored) or set the same variables
# in the process environment / your host's dashboard. Real environment
# variables win over values in server/.env. Never commit real secrets.

# ── Storage ────────────────────────────────────────────────────────────────
# SQLite database file (accounts, sessions, subscriptions, file index).
# Default: server/data/pdfaxe.sqlite3   (Docker image: /data/pdfaxe.sqlite3)
# SFM_DB_PATH=/srv/pdfaxe/pdfaxe.sqlite3
# Folder holding users' uploaded files, one sub-folder per user id.
# Default: server/data/storage           (Docker image: /data/storage)
# SFM_STORAGE_DIR=/srv/pdfaxe/storage

# ── Public address ─────────────────────────────────────────────────────────
# The HTTPS URL people reach this server at, with no trailing slash.
# Used to build Stripe Checkout success/cancel and portal return URLs.
SFM_PUBLIC_URL=http://127.0.0.1:8000

# ── Accounts and storage limits ────────────────────────────────────────────
# How long a sign-in stays valid, in days.
SFM_SESSION_DAYS=30
# Cloud storage quota per subscriber, in MB (5120 = 5 GB).
SFM_STORAGE_QUOTA_MB=5120
# Largest single file upload, in MB.
SFM_MAX_UPLOAD_MB=200

# ── Stripe monthly subscription ────────────────────────────────────────────
# Billing is switched on only when STRIPE_SECRET_KEY and STRIPE_PRICE_ID are
# both set; otherwise /billing/* answers 503 and /health reports billing "none".
# Secret API key: Dashboard > Developers > API keys (sk_test_... or sk_live_...).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Required for /billing/webhook.
STRIPE_WEBHOOK_SECRET=
# ID of the monthly recurring Price of your subscription product (price_...).
STRIPE_PRICE_ID=
# Text shown in the desktop app next to the Subscribe button.
SFM_PLAN_LABEL=Monthly plan

# ── Testing only ───────────────────────────────────────────────────────────
# Set to 1 to stop server.app from building the module-level `app` on import
# (the test suite does this). Leave unset in production.
# SFM_SERVER_NO_AUTOAPP=1
